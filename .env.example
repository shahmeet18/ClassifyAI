# ─── Hermes LLM Agent Configuration ─────────────────────────────────────────
# Base URL for the LLM provider (Anthropic, OpenAI-compatible, or local Ollama).
HERMES_BASE_URL=https://api.anthropic.com

# API key — use "ollama" for local Ollama (no auth), or your real key for cloud.
HERMES_API_KEY=your-hermes-api-key-here

# Model name exactly as the endpoint expects it.
HERMES_MODEL=claude-haiku-4-5-20251001

# ─── Supabase (Auth & Database) ──────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Web Frontend ─────────────────────────────────────────────────────────────
# URL of the running ClassifyAI backend (default: localhost for local dev).
VITE_API_URL=http://localhost:8000
